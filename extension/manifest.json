{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zimer"
  },
  "description": "Track time against your self-hosted Zimer server.",
  "manifest_version": 3,
  "name": "Zimer",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "storage"
  ],
  "version": "0.1.0",
  "background": {
    "service_worker": "bg.js"
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start or stop the Zimer timer"
    }
  }
}
